# MuseGen 环境变量配置模板
# 复制此文件为 .env 并填写实际值

# ============================================================
# 模式切换: "api" = 外部付费API, "gpu" = 自建GPU服务器
# ============================================================
AI_BACKEND=gpu

# ============================================================
# GPU 服务器配置 (AutoDL / 自建)
# ============================================================
GPU_SERVER_HOST=127.0.0.1
GPU_SERVER_SSH_PORT=22
GPU_SERVER_SSH_USER=root
GPU_SERVER_SSH_PASSWORD=

# Ollama (大语言模型)
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL=qwen3:14b

# ComfyUI (图像生成 + 视频生成)
COMFYUI_BASE_URL=http://127.0.0.1:8188
COMFYUI_SDXL_WORKFLOW=sdxl_anime.json
COMFYUI_ANIMATEDIFF_WORKFLOW=animatediff.json

# CosyVoice (语音合成)
COSYVOICE_BASE_URL=http://127.0.0.1:5000

# ============================================================
# 以下为 AI_BACKEND=api 时需要的密钥 (GPU模式可忽略)
# ============================================================

# PostgreSQL
DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/animevideo

# Redis
REDIS_URL=redis://localhost:6379/0

# MinIO / S3 对象存储
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=animevideo
S3_REGION=us-east-1

# OpenAI (仅 api 模式)
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o

# Replicate (仅 api 模式)
REPLICATE_API_TOKEN=r8_...
SDXL_MODEL_VERSION=stability-ai/sdxl:39ed52f2319f9c52de0b4b5303d5aab78e0d4291e02a49a8c0e75f7bf0a33e14
SVD_MODEL_VERSION=stability-ai/stable-video-diffusion:3f0457e4619daac51203dedb472816fd4af51f3149fa7a9e0b5ffcf1b8172438

# ElevenLabs TTS (仅 api 模式)
ELEVENLABS_API_KEY=el_...

# 火山引擎 TTS (仅 api 模式)
VOLC_TTS_APP_ID=
VOLC_TTS_TOKEN=

# API 配额限制
MAX_DAILY_IMAGE_CALLS=500
MAX_DAILY_VIDEO_CALLS=100
MAX_DAILY_TTS_CHARS=100000

# CORS
CORS_ORIGINS=http://localhost:5173

# JWT 密钥
SECRET_KEY=change-me-in-production